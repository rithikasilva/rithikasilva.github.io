---
interface Props {
  title: string;
  description?: string;
  type?: "website" | "article";
  wide?: boolean;
}

const {
  title,
  description = "Rithika Silva — System Software Engineer interested in combinatorics, graph theory, mathematical optimization, developer efficiency, and collaborative agent systems.",
  type = "website",
  wide = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Rithika Silva" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <slot name="head" />
  </head>
  <body class:list={{ wide }}>
    <slot name="loader" />
    <slot />
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Satoshi";
    src: url("/fonts/Satoshi-Variable.ttf") format("truetype");
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }
  :root { color-scheme: light; background: #fafaf7; color: #373a34; font-family: "Satoshi", sans-serif; font-size: 16px; }
  body { margin: 0; line-height: 1.75; -webkit-font-smoothing: antialiased; }
  main { box-sizing: border-box; max-width: 656px; margin: 88px auto; padding: 0 28px; }
  body.wide main { max-width: 1152px; }
  h1, h2, h3 { font-family: inherit; color: #20241e; font-weight: 600; line-height: 1.35; }
  h1 { font-size: 1.5rem; letter-spacing: -.035em; margin: 2.5rem 0 1.75rem; }
  h2 { font-size: 1.15rem; letter-spacing: -.02em; margin: 2rem 0 1rem; }
  h3 { font-size: 1rem; margin: 1.5rem 0 .7rem; }
  p { margin: 1rem 0; }
  section { margin: 2.75rem 0; }
  section > h2 { color: #686e62; font-size: .7rem; font-weight: 500; letter-spacing: .09em; text-transform: uppercase; margin-bottom: 1.25rem; }
  main > a:first-child, main > article > a:first-child { font-size: .85rem; color: #686e62; }
  article + article { margin-top: 2rem; }
  a, a:visited { color: #242b20; text-decoration: underline; text-decoration-color: #b5bbae; text-decoration-thickness: 1px; text-underline-offset: 4px; }
  a:hover { color: #000; text-decoration-color: #242b20; }
  :focus-visible { outline: 2px solid #53634a; outline-offset: 4px; }
  ul, ol { margin: 1rem 0; padding-left: 1.5rem; }
  ul { list-style: disc; }
  ol { list-style: decimal; }
  li { margin: .4rem 0; }
  nav ul { margin: 1.25rem 0; }
  button, input { font: inherit; }
  button { cursor: pointer; }
  button:disabled { cursor: default; }
  time, .post-date { color: #555; font-size: .9rem; }
  #post-list { list-style: none; padding: 0; }
  #post-list > li { margin: 1.5rem 0; }
  #post-list h2 { font-size: 1.05rem; margin: .25rem 0; }
  .prose-blog { margin-top: 2rem; overflow-wrap: break-word; }
  .prose-blog img { max-width: 100%; height: auto; }
  .prose-blog pre { overflow-x: auto; padding: 1rem; font-size: .85rem; margin: 1.5rem 0; }
  .prose-blog code { font-family: ui-monospace, monospace; font-size: .9em; }
  .prose-blog :not(pre) > code { background: #f1f1f1; padding: .1rem .2rem; }
  .prose-blog blockquote { border-left: 2px solid #aaa; margin: 1.5rem 0; padding-left: 1rem; color: #444; }
  .prose-blog .katex-display { overflow-x: auto; overflow-y: hidden; padding: .25rem 0; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  .hidden, [hidden] { display: none !important; }
  .home { max-width: 800px; font-size: 1.125rem; margin-top: clamp(80px, 16vh, 160px); }
  .home h1 { font-size: 1.575rem; margin: 0 0 1.1rem; }
  .home .intro { margin: 0; }
  .home .interests { display: flex; flex-wrap: wrap; gap: .4rem; list-style: none; padding: 0; margin: 1rem 0 0; color: #62685c; font-size: .75rem; line-height: 1.5; }
  .home .interests li { margin: 0; padding: .15rem .45rem; border: 1px solid #dcdfd6; border-radius: 4px; white-space: nowrap; }
  .home .interests li span { color: #8a907f; margin-right: .08em; }
  .home nav ul { display: flex; flex-wrap: wrap; gap: .4rem 1.5rem; list-style: none; padding: 0; margin: 2.25rem 0 0; }
  .home nav li { margin: 0; }
  .home .profiles { margin-top: 1.5rem; font-size: .9rem; display: flex; gap: 1.25rem; }
  .home .profiles a { color: #686e62; text-decoration-color: #d2d6cb; }
  @media (max-width: 600px) {
    main { margin: 40px auto; padding: 0 24px; }
    .home { margin-top: 80px; }
    .home nav ul { gap: .65rem 1.25rem; }
  }
</style>
