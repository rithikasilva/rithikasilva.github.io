---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Rithika Silva - Projects" description="Things I've built and contributed to">
  <main class="mt-20 text-white max-w-4xl mx-auto p-6">
    <a href="/" class="text-gray-400 hover:text-gray-100 mb-8 inline-block">&larr; Back</a>
    <h1 class="text-4xl font-bold mb-8">Projects</h1>

    <ul class="space-y-4">
      <li>
        <a href="https://github.com/rithikasilva/.dotfiles" target="_blank" class="text-gray-100 hover:text-white text-lg underline">My Dotfiles</a>
        <p class="text-gray-300 mt-1">Eternally changing :)</p>
      </li>
      <li>
        <a href="https://github.com/uwaggs/usportspy" target="_blank" class="text-gray-100 hover:text-white text-lg underline">usportspy</a>
        <p class="text-gray-300 mt-1">One-stop-shop for USPORTS data.</p>
      </li>
      <li>
        <a href="https://github.com/catppuccin/blink" target="_blank" class="text-gray-100 hover:text-white text-lg underline">Catppuccin - Blink</a>
        <p class="text-gray-300 mt-1">Soothing pastel theme for Blink Shell.</p>
      </li>
      <li>
        <a href="https://github.com/rithikasilva/readme-lol-stats" target="_blank" class="text-gray-100 hover:text-white text-lg underline">README Profile LoL Stats</a>
        <p class="text-gray-300 mt-1">GitHub Action to display your League of Legends statistics on your README profile.</p>
      </li>
      <li>
        <a href="https://github.com/rithikasilva/go-lambda-calc" target="_blank" class="text-gray-100 hover:text-white text-lg underline">Lambda Calculus Interpreter</a>
        <p class="text-gray-300 mt-1">Normal order reduction, variable capture avoiding, and custom expressions.</p>
      </li>
    </ul>
  </main>
</Layout>
