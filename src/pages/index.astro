---
import Layout from "../layouts/Layout.astro";
import NowPlaying from "../components/NowPlaying.astro";
import { LINKS } from "../lib/constants";
---

<Layout title="Rithika Silva">
  <main class="home">
    <h1>Rithika Silva<span class="visually-hidden"> (he/him)</span></h1>
    <p class="intro">System Software Engineer at <a href={LINKS.nvidia_av}>NVIDIA</a>. UWaterloo CS alum.</p>
    <ul class="interests" aria-label="Interests">
      <li><span aria-hidden="true">#</span>systems-programming</li>
      <li><span aria-hidden="true">#</span>performance-optimization</li>
      <li><span aria-hidden="true">#</span>collaborative-agent-systems</li>
      <li><span aria-hidden="true">#</span>dev-efficiency</li>
      <li><span aria-hidden="true">#</span>combinatorics</li>
      <li><span aria-hidden="true">#</span>graph-theory</li>
      <li><span aria-hidden="true">#</span>mathematical-optimization</li>
    </ul>
    <nav aria-label="Main navigation">
      <ul>
        <li><a href="/work">Projects &amp; Contributions</a></li>
        <li><a href="/archive">Writing</a></li>
        <li><a href="/gallery">Photography</a></li>
      </ul>
    </nav>
    <p class="profiles"><a href={LINKS.github}>GitHub</a><a href={LINKS.linkedin}>LinkedIn</a></p>
    <NowPlaying />
  </main>
</Layout>
