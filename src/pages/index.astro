---
import Layout from "../layouts/Layout.astro";
import { LINKS } from "../lib/constants";
---

<Layout title="Rithika Silva">
  <main class="text-white min-h-screen flex items-center justify-center p-8">
    <div class="max-w-3xl mx-auto">
      <!-- Name -->
      <h1 class="text-5xl md:text-6xl font-bold mb-6">Hi! I'm Rithika.</h1>

      <!-- Bio -->
      <p class="text-xl text-gray-300 mb-8 leading-relaxed">
        I'm a <a class="link-inline" href="https://uwaterloo.ca/" target="_blank">UWaterloo</a> CS alum and software engineer. My interests include <span class="link-inline-plain">combinatorics</span>, <span class="link-inline-plain">mathematical optimization</span>, and <span class="link-inline-plain">developer tooling</span>.
      </p>

      <!-- Links and Contact -->
      <div class="space-y-4">
        <div>
          <h2 class="text-gray-400 text-sm uppercase tracking-wide mb-2">Links</h2>
          <div class="flex flex-wrap gap-x-4 gap-y-2 text-lg">
            <a href="/gallery" class="link-nav">Photography</a>
            <a href="/archive" class="link-nav">Archive</a>
          </div>
        </div>

        <div>
          <h2 class="text-gray-400 text-sm uppercase tracking-wide mb-2">Contact</h2>
          <div class="flex flex-wrap gap-x-4 gap-y-2 text-lg">
            <a href={LINKS.linkedin} target="_blank" class="link-nav">LinkedIn</a>
            <a href={LINKS.github} target="_blank" class="link-nav">GitHub</a>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>
