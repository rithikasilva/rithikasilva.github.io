---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import { photoDescriptions } from '../lib/photo-descriptions';

const files = import.meta.glob<{ default: ImageMetadata }>('../../public/static/photos/*.{jpg,jpeg,JPG}', { eager: true });
const photos = await Promise.all(
  Object.entries(files).sort(([a], [b]) => b.localeCompare(a)).map(async ([path, image]) => {
    const source = image.default;
    const widths = [...new Set([400, 600, 960].map((width) => Math.min(width, source.width)))];
    const thumbnails = await Promise.all(widths.map((width) => getImage({ src: source, width, format: 'webp', quality: 80 })));
    const preview = await getImage({ src: source, width: Math.min(1920, source.width), format: 'webp', quality: 85 });
    const filename = path.split('/').pop()!;
    return {
      alt: photoDescriptions[filename] ?? 'Photograph by Rithika Silva',
      original: `/static/photos/${filename}`,
      thumbnail: thumbnails[1] ?? thumbnails[0],
      srcset: thumbnails.map((image, i) => `${image.src} ${widths[i]}w`).join(', '),
      preview: preview.src,
      width: source.width,
      height: source.height,
    };
  })
);
---

<Layout wide title="Photography — Rithika Silva" description="Photographs by Rithika Silva: city streets, architecture, landscapes, and everyday details.">
  <main>
    <p><a href="/">← Home</a></p>
    <h1 class="visually-hidden">Photography</h1>
    <div class="photo-grid">
      {photos.map((photo, index) => (
        <button
          type="button"
          class="photo-trigger"
          aria-label={`View photo ${index + 1}: ${photo.alt}`}
          aria-haspopup="dialog"
          data-preview={photo.preview}
          data-original={photo.original}
        >
          <img
            src={photo.thumbnail.src}
            srcset={photo.srcset}
            sizes="(min-width: 1280px) 271px, (min-width: 1024px) 365px, (min-width: 768px) calc((100vw - 44px) / 2), calc(100vw - 32px)"
            width={photo.width}
            height={photo.height}
            alt={photo.alt}
            loading={index < 2 ? 'eager' : 'lazy'}
            decoding="async"
          />
        </button>
      ))}
    </div>
  </main>

  <dialog id="photo-viewer" aria-label="Photo viewer">
    <div class="viewer-content">
      <p id="photo-status" class="viewer-status" role="status" aria-live="polite" aria-atomic="true"></p>
      <button type="button" id="close-photo" class="viewer-control close" aria-label="Close photo viewer" autofocus>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
      </button>
      <button type="button" id="previous-photo" class="viewer-control previous" aria-label="Previous photo">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 6-6 6 6 6" /></svg>
      </button>
      <figure>
        <img id="viewer-image" alt="" />
      </figure>
      <button type="button" id="next-photo" class="viewer-control next" aria-label="Next photo">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
      </button>
      <a id="original-photo" class="link-nav original" target="_blank" rel="noreferrer">Open original ↗</a>
    </div>
  </dialog>
</Layout>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#photo-viewer')!;
  const triggers = [...document.querySelectorAll<HTMLButtonElement>('.photo-trigger')];
  const image = document.querySelector<HTMLImageElement>('#viewer-image')!;
  const previous = document.querySelector<HTMLButtonElement>('#previous-photo')!;
  const next = document.querySelector<HTMLButtonElement>('#next-photo')!;
  const close = document.querySelector<HTMLButtonElement>('#close-photo')!;
  const original = document.querySelector<HTMLAnchorElement>('#original-photo')!;
  const status = document.querySelector<HTMLElement>('#photo-status')!;
  let current = 0;
  let opener: HTMLButtonElement | undefined;
  let previousOverflow = '';

  function display(index: number) {
    current = index;
    const trigger = triggers[index];
    image.src = trigger.dataset.preview!;
    image.alt = trigger.querySelector('img')!.alt;
    original.href = trigger.dataset.original!;
    status.textContent = `Photo ${index + 1} of ${triggers.length}`;
    previous.disabled = index === 0;
    next.disabled = index === triggers.length - 1;
    // Keep focus usable when navigating onto a disabled boundary control.
    if ((previous.disabled && document.activeElement === previous) || (next.disabled && document.activeElement === next)) close.focus();
  }

  triggers.forEach((trigger, index) => {
    trigger.addEventListener('click', () => {
      opener = trigger;
      display(index);
      previousOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';
      dialog.showModal();
    });
  });
  close.addEventListener('click', () => dialog.close());
  dialog.addEventListener('close', () => {
    document.body.style.overflow = previousOverflow;
    opener?.focus({ preventScroll: true });
    image.removeAttribute('src');
  });
  previous.addEventListener('click', () => { if (current > 0) display(current - 1); });
  next.addEventListener('click', () => { if (current < triggers.length - 1) display(current + 1); });
  dialog.addEventListener('keydown', (event) => {
    if (event.key === 'Tab') {
      const controls = [close, previous, next, original].filter((control) => !(control instanceof HTMLButtonElement && control.disabled));
      const first = controls[0];
      const last = controls[controls.length - 1];
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
      else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
    }
    if (event.key === 'ArrowRight' && current < triggers.length - 1) { event.preventDefault(); display(current + 1); }
    if (event.key === 'ArrowLeft' && current > 0) { event.preventDefault(); display(current - 1); }
  });
  dialog.addEventListener('click', (event) => {
    if (event.target === dialog || event.target === dialog.querySelector('.viewer-content')) dialog.close();
  });
  let touchStart: { x: number; y: number } | undefined;
  image.addEventListener('touchstart', (event) => {
    if (event.touches.length !== 1) { touchStart = undefined; return; }
    touchStart = { x: event.touches[0].clientX, y: event.touches[0].clientY };
  }, { passive: true });
  image.addEventListener('touchend', (event) => {
    if (!touchStart) return;
    const dx = event.changedTouches[0].clientX - touchStart.x;
    const dy = event.changedTouches[0].clientY - touchStart.y;
    touchStart = undefined;
    if (Math.abs(dx) < 50 || Math.abs(dx) < Math.abs(dy)) return;
    if (dx < 0 && current < triggers.length - 1) display(current + 1);
    if (dx > 0 && current > 0) display(current - 1);
  }, { passive: true });
</script>

<style>
  .photo-grid { display: grid; gap: .75rem; margin-top: 2rem; }
  .photo-trigger { display: block; width: 100%; padding: 0; border: 0; background: transparent; cursor: pointer; }
  .photo-trigger img { display: block; width: 100%; height: auto; }
  @media (min-width: 768px) {
    .photo-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .photo-trigger img { aspect-ratio: 1; object-fit: cover; }
  }
  @media (min-width: 1024px) { .photo-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1280px) { .photo-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  dialog { position: fixed; inset: 0; width: 100%; height: 100%; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; color: #f5f5f5; background: rgb(0 0 0 / .96); }
  dialog::backdrop { background: #000; }
  dialog :focus-visible { outline-color: #fff; }
  .viewer-content { position: relative; display: flex; align-items: center; justify-content: center; height: 100%; padding: 4rem 4.5rem; }
  figure { margin: 0; max-width: 100%; text-align: center; }
  #viewer-image { display: block; max-width: 100%; max-height: calc(100dvh - 8rem); width: auto; height: auto; margin: auto; object-fit: contain; }
  .viewer-control { display: grid; place-items: center; padding: 0; position: absolute; width: 44px; height: 44px; border-radius: 50%; background: #171717; color: white; border: 1px solid #525252; cursor: pointer; font-size: 2rem; line-height: 1; }
  .viewer-control svg { display: block; width: 24px; height: 24px; }
  .close svg { width: 20px; height: 20px; }
  .viewer-control:disabled { opacity: .3; cursor: default; }
  .close { top: 1rem; right: 1rem; font-size: 1.25rem; }
  .previous { left: 1rem; }
  .next { right: 1rem; }
  .viewer-status { position: absolute; top: 1.5rem; left: 1rem; margin: 0; font-size: .875rem; }
  .original, .original:visited { color: #fff; }
  .original { position: absolute; bottom: 1.5rem; font-size: .875rem; }
  @media (max-width: 767px) {
    .viewer-content { padding: 4.5rem 1rem 7rem; }
    #viewer-image { max-height: calc(100dvh - 12rem); }
    .previous, .next { bottom: 1rem; }
  }
</style>
