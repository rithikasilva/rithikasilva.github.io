---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<Layout title={`${post.data.title} — Rithika Silva`}>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" slot="head" />
  <main class="mt-20 text-white w-full max-w-3xl mx-auto px-6 sm:px-0 py-6">
    <a href="/archive" class="text-gray-400 hover:text-gray-100 transition-all mb-8 inline-block">&larr; Archive</a>

    <div class="mb-10">
      <p class="text-gray-500 text-sm mb-2">
        {post.data.date.toLocaleDateString('en-CA', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        })}
      </p>
      <h1 class="text-4xl font-bold mb-4">{post.data.title}</h1>
      {post.data.tags.length > 0 && (
        <div class="flex gap-2 flex-wrap">
          {post.data.tags.map((tag) => (
            <a
              href={`/blog?tag=${tag}`}
              class="text-xs text-gray-500 border border-gray-700 rounded px-2 py-0.5 hover:border-gray-400 hover:text-gray-300 transition-all"
            >
              {tag}
            </a>
          ))}
        </div>
      )}
    </div>

    <article class="prose-blog">
      <Content />
    </article>
  </main>
</Layout>

<style>
  .prose-blog :global(h2) {
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: #f5f5f5;
  }
  .prose-blog :global(h3) {
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    color: #f5f5f5;
  }
  .prose-blog :global(p) {
    color: #d4d4d4;
    line-height: 1.75;
    margin-bottom: 1.25rem;
  }
  .prose-blog :global(a) {
    color: #f5f5f5;
    text-decoration: underline;
    text-decoration-color: #525252;
    text-underline-offset: 4px;
    transition: all 0.15s;
  }
  .prose-blog :global(a:hover) {
    color: white;
    filter: drop-shadow(0 0 8px rgba(255, 255, 255, 0.8));
  }
  .prose-blog :global(code) {
    background: #1a1a1a;
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.875rem;
    color: #d4d4d4;
  }
  .prose-blog :global(pre) {
    background: #111111;
    border: 1px solid #404040;
    border-radius: 0.5rem;
    padding: 1rem;
    overflow-x: auto;
    margin-bottom: 1.5rem;
  }
  .prose-blog :global(pre code) {
    background: transparent;
    padding: 0;
    font-size: 0.875rem;
  }
  .prose-blog :global(blockquote) {
    border-left: 2px solid #525252;
    padding-left: 1rem;
    color: #a3a3a3;
    font-style: italic;
    margin: 1.5rem 0;
  }
  .prose-blog :global(ul) {
    color: #d4d4d4;
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }
  .prose-blog :global(ol) {
    color: #d4d4d4;
    list-style-type: decimal;
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }
  .prose-blog :global(li) {
    margin-bottom: 0.375rem;
    line-height: 1.75;
  }
  .prose-blog :global(hr) {
    border-color: #404040;
    margin: 2rem 0;
  }
  .prose-blog :global(img) {
    max-width: 100%;
    border-radius: 0.5rem;
    margin: 1.5rem 0;
  }
  .prose-blog :global(.katex-display) {
    margin: 1.5rem 0;
  }
</style>
