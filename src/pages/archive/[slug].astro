---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('archive');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<Layout title={`${post.data.title} — Rithika Silva`} description={`${post.data.title} — writing by Rithika Silva on ${post.data.tags.filter((tag) => !["post", "note"].includes(tag)).join(", ")}.`} type="article">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" slot="head" />
  <main>
    <a href="/archive">&larr; Writing</a>

    <div>
      <p>
        {post.data.date.toLocaleDateString('en-CA', {
          timeZone: 'UTC',
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        })}
      </p>
      <h1>{post.data.title}</h1>

    </div>

    <article class="prose-blog">
      <Content />
    </article>
  </main>
</Layout>
